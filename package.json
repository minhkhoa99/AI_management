{
  "name": "@minhkhoa/aimanagement",
  "version": "0.4.0-beta.0",
  "description": "AI Team: nền tảng điều phối nhiều agent AI (Claude Code, Codex, Custom API) theo phòng ban, chạy hoàn toàn trên máy.",
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "orchestration",
    "local"
  ],
  "license": "MIT",
  "author": "minhkhoa99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhkhoa99/AI_management.git"
  },
  "homepage": "https://github.com/minhkhoa99/AI_management#readme",
  "bugs": {
    "url": "https://github.com/minhkhoa99/AI_management/issues"
  },
  "type": "module",
  "bin": {
    "aimanagement": "bin/aiteam.mjs"
  },
  "files": [
    "bin/aiteam.mjs",
    "bin/node-version-policy.mjs",
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "workspaces": [
    "packages/contracts",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check . && npm run typecheck",
    "typecheck": "tsc -p packages/contracts --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "start": "node bin/aiteam.mjs",
    "test:smoke": "node scripts/smoke-test-dist.mjs",
    "check:bundle": "node scripts/check-web-bundle.mjs",
    "measure": "node scripts/measure-runtime.mjs",
    "prepublishOnly": "npm run lint && npm test",
    "prepack": "npm run build && npm run test:smoke && npm run check:bundle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
