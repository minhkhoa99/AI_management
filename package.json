{
  "name": "aiteam",
  "version": "0.1.0",
  "description": "Nền tảng điều phối nhiều agent AI theo phòng ban, chạy hoàn toàn trên máy.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "aiteam": "bin/aiteam.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "workspaces": [
    "packages/contracts",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check . && npm run typecheck",
    "typecheck": "tsc -p packages/contracts --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "start": "node bin/aiteam.mjs",
    "test:smoke": "node scripts/smoke-test-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
